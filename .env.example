# Reference settings only: ASP.NET/Python do not automatically load this file.
# Copy ONLY NEXT_PUBLIC_* entries into frontend/.env.local.
NEXT_PUBLIC_API_BASE=http://localhost:5100
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ASP.NET process environment (never prefix server secrets with NEXT_PUBLIC_).
ASPNETCORE_URLS=http://localhost:5100
Backend__PublicUrl=http://localhost:5100
Firebase__ProjectId=
Pipeline__BaseUrl=http://127.0.0.1:8100
Pipeline__ApiKey=
Pipeline__TimeoutSeconds=240
# Colab URL/key live in the protected DB setting, not environment/appsettings fallbacks.
# Match the notebook's COLAB_REGISTRATION_SECRET; use a strong printable shared secret.
Colab__RegistrationSecret=
Colab__TimeoutSeconds=300
Colab__MaxRetries=2
Colab__RetryBaseMilliseconds=250
Colab__BreakerFailures=5
Colab__BreakerSeconds=30
Colab__HeartbeatStaleSeconds=120
# Verified Firebase UIDs only; add further admins as __1, __2, etc. Workspace owners are not platform admins.
Operations__AdminFirebaseUids__0=
Operations__MetricsKey=
# Persist/backup the key ring outside the application tree with service-account-only access.
# DataProtection__KeyRingPath=D:\clinical-rag-data\key-ring
# Embedding requests are checkpointed batches; values cannot raise the shared caps.
Embedding__BatchSize=32
Embedding__MaxRetries=2
Embedding__RetryBaseMilliseconds=250
Embedding__TimeoutSeconds=120
# Process-local vector/BM25 cache: memory budget and absolute expiry.
Retrieval__CacheSizeMegabytes=512
Retrieval__CacheSeconds=120
# Set your own SQL Server connection string in the backend environment.
# ConnectionStrings__Default=
# Set false in production and apply reviewed migrations separately.
# Database__AutoMigrate=false
# Use a persistent upload root restricted to the API service account; do not use symlinks/junctions.
# Documents__UploadsDirectory=D:\clinical-rag-data\uploads
# Bounded durable file-cleanup worker defaults to true (20 records every 30 seconds).
# Documents__AutomaticFileCleanup=true

# Leave UNSET for per-request defaults: short questions on, cases/follow-ups off.
# false disables all storage; true opts in to privacy-projected case evidence.
# Privacy__StoreResults=false

# Python process environment: set BEFORE importing/starting pipeline_service.app.
PIPELINE_SERVICE_KEY=
PIPELINE_RETRIEVE_BASE_URL=http://localhost:5100
PIPELINE_TIMEOUT_SECONDS=240
# The production pipeline resolves fresh Colab credentials from ASP.NET using PIPELINE_SERVICE_KEY.
# COLAB_GENERATE_URL/COLAB_API_KEY are legacy standalone CLI settings, not production URL rotation.
# Colab-only optional lower caps; coordinate backend batch/candidate settings.
# COLAB_MAX_EMBED_TEXTS=32
# COLAB_MAX_RERANK_PASSAGES=30
# Pipeline__ApiKey must match PIPELINE_SERVICE_KEY (a strong shared secret).
# Notebook Colab Secrets: COLAB_API_KEY, ASPNET_BACKEND_URL (public HTTPS backend origin),
# and COLAB_REGISTRATION_SECRET (matching Colab__RegistrationSecret).
# Do not copy any service/registration/model secret into frontend/.env.local.
